# Modelo de configuração — só os NOMES. Os valores reais ficam no .env de cada
# ambiente (nunca versionado) ou nas variáveis da stack no Portainer.
#
# Em desenvolvimento o servidor também lê os .env das pastas ACIMA do projeto
# (o .env compartilhado da pasta de trabalho), então não é preciso copiar as
# credenciais para cá. Em produção isso fica desligado.

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# porta da API (em dev: 8095; ACCESS_CONTROL_PORT tem prioridade sobre PORT)
PORT=8095
HOST=0.0.0.0
# saltos de proxy reverso à frente do contêiner (0 = acesso direto)
TRUST_PROXY=0
# onde fica o banco SQLite da aplicação (padrão: server/data; no contêiner, /app/data)
DATA_PATH=

# ---------------------------------------------------------------------------
# Voalle — db_elleven (PostgreSQL). SOMENTE LEITURA.
# Também aceita os nomes DB_ELLEVEN_* do .env compartilhado.
# ---------------------------------------------------------------------------
DB_VOALLE_HOST=
DB_VOALLE_PORT=5432
DB_VOALLE_DATABASE=
DB_VOALLE_USER=
DB_VOALLE_PASSWORD=
DB_VOALLE_SCHEMA=
DB_VOALLE_SSL=false
DB_VOALLE_POOL_MAX=2
QUERY_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Fila de protocolos de Gestão de Acessos
# ---------------------------------------------------------------------------
# releitura do Voalle (ms) — a consulta leva ~50 ms; mínimo 15000
PROTOCOLS_REFRESH_MS=180000
# protocolos criados a partir de (AAAA-MM-DD)
PROTOCOLS_SINCE=2026-01-01
# categoria 1 do Voalle que define a fila
PROTOCOLS_CATEGORY=Gestão de Acessos

# ---------------------------------------------------------------------------
# Conexão direta com os hubs — SOMENTE LEITURA (opcional)
# Sem estas credenciais a integração fica desligada e as telas seguem com
# "Importar export" e cadastro manual.
# ---------------------------------------------------------------------------
# HUB APPS: o MySQL do hub (DB_Hub_Apps). Peça um usuário só com SELECT nas
# tabelas users, teams e apps.
HUB_APPS_DB_HOST=
HUB_APPS_DB_PORT=3306
HUB_APPS_DB_NAME=DB_Hub_Apps
HUB_APPS_DB_USER=
HUB_APPS_DB_PASSWORD=
HUB_APPS_DB_SSL=false
# HUB BI: o Firestore do hub (projeto sebratel-tecnologia), com uma conta de
# serviço só de leitura (papel "Cloud Datastore Viewer"). Use UMA das formas:
#   a) caminho do JSON da conta de serviço:
HUB_BI_FIREBASE_CREDENTIALS_FILE=
#   b) ou os campos da conta (a chave numa linha só, com \n no lugar das quebras):
HUB_BI_FIREBASE_PROJECT_ID=
HUB_BI_FIREBASE_CLIENT_EMAIL=
HUB_BI_FIREBASE_PRIVATE_KEY=
# de quanto em quanto tempo sincroniza (ms). 0 = só pelo botão "Sincronizar
# agora". Cada sincronização do HUB BI lê ~1 mil documentos no Firestore (cobrado).
HUB_SYNC_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# Login com Google (mesmo projeto OAuth das outras dashboards)
# ---------------------------------------------------------------------------
AUTH_ENABLED=true
# ID do cliente OAuth (público). Também aceita VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=sebratel.com.br
# Admin(s) de fábrica, separados por vírgula. Só valem enquanto NÃO houver
# nenhum admin na tela de Equipe (instalação nova).
ADMIN_EMAILS=
